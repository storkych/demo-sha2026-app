{
  "name": "flight-archive-quest",
  "version": "1.0.3",
  "private": true,
  "description": "Portable aviation quest",
  "author": "Quest Team",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "test": "node --test tests/*.test.mjs",
    "desktop": "npm run build && electron .",
    "pack": "npm run build && node scripts/package.cjs",
    "test:browser": "node tests/browser.mjs",
    "test:desktop": "node tests/desktop.mjs"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.50.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.4.0",
    "electron": "^44.4.5",
    "electron-builder": "^26.0.0",
    "typescript": "^5.7.0",
    "vite": "^6.1.0"
  },
  "build": {
    "appId": "ru.quest.flightarchive",
    "productName": "Flight Archive",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": "portable",
      "signAndEditExecutable": false,
      "icon": "build/icon.ico"
    },
    "artifactName": "FlightArchive-Portable-${version}.${ext}"
  }
}
